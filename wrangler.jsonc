{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "checklistdiary",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "checklistdiary",
      "database_id": "2f59fa87-4bf0-44c6-9e25-d7db55fb91ee"
    }
  ]
}
